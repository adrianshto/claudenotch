<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.casper.claudenotch</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/ClaudeNotch.app/Contents/MacOS/ClaudeNotch</string>
    </array>
    <!-- Start at login (and when this agent is loaded). -->
    <key>RunAtLoad</key>
    <true/>
    <!-- Relaunch only on a crash (non-zero exit). A clean quit from the menu stays quit. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <!-- GUI/menu-bar app. -->
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
